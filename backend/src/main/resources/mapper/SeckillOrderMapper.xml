<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="org.example.mapper.SeckillOrderMapper">

    <!-- 结果映射 -->
    <resultMap id="BaseResultMap" type="org.example.entity.SeckillOrder">
        <id column="id" property="id" />
        <result column="user_id" property="userId" />
        <result column="activity_id" property="activityId" />
        <result column="order_no" property="orderNo" />
        <result column="created_at" property="createdAt" />
    </resultMap>

    <!-- 基础列 -->
    <sql id="Base_Column_List">
        id, user_id, activity_id, order_no, created_at
    </sql>

    <!-- 插入秒杀订单 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO seckill_order (
            user_id, activity_id, order_no, created_at
        ) VALUES (
            #{userId}, #{activityId}, #{orderNo}, NOW()
        )
    </insert>

    <!-- 根据用户ID和活动ID查询订单（防止重复购买） -->
    <select id="selectByUserAndActivity" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List" />
        FROM seckill_order
        WHERE user_id = #{userId} AND activity_id = #{activityId}
        LIMIT 1
    </select>

</mapper>
