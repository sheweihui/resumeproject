/* ===== 设计系统 ===== */

/* 主题色 */
page {
  --primary: #4a90d9;
  --primary-light: #67b8f7;
  --primary-gradient: linear-gradient(135deg, #4a90d9 0%, #67b8f7 100%);
  --green: #5eb97d;
  --green-light: #7ed39e;
  --green-gradient: linear-gradient(135deg, #5eb97d 0%, #7ed39e 100%);
  --purple: #667eea;
  --purple-light: #764ba2;
  --purple-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  --red: #f5576c;
  --orange: #f59e0b;
  --text-primary: #1f2937;
  --text-secondary: #6b7280;
  --text-muted: #9ca3af;
  --bg-page: #f5f5f5;
  --bg-card: #ffffff;
  --border: #f0f0f0;
  --shadow-sm: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
  --shadow-md: 0 8rpx 24rpx rgba(0, 0, 0, 0.08);
  --radius-sm: 12rpx;
  --radius-md: 20rpx;
  --radius-lg: 24rpx;
  --radius-xl: 32rpx;
  --safe-bottom: env(safe-area-inset-bottom);
  height: 100%;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  background-color: var(--bg-page);
  -webkit-font-smoothing: antialiased;
}

view, text, scroll-view, image, input, textarea {
  box-sizing: border-box;
}

/* ===== 通用组件 ===== */

/* 页面头部 */
.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 32rpx 40rpx;
  background: var(--primary-gradient);
}

.page-header .page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
}

.page-header .header-back {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  font-size: 36rpx;
  color: #fff;
}

.page-header .header-action {
  display: flex;
  align-items: center;
  background: rgba(255,255,255,0.2);
  padding: 12rpx 24rpx;
  border-radius: 32rpx;
  font-size: 28rpx;
  color: #fff;
}

/* 卡片 */
.card {
  background: var(--bg-card);
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
  animation: fadeIn 0.2s ease;
}

.modal-content {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: var(--radius-xl) var(--radius-xl) 0 0;
  overflow: hidden;
  animation: slideUp 0.3s ease;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx;
  border-bottom: 1rpx solid var(--border);
}

.modal-header .modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--text-muted);
  border-radius: 50%;
  background: var(--bg-page);
}

.modal-body {
  padding: 32rpx;
  max-height: calc(85vh - 200rpx);
  overflow-y: auto;
}

.modal-footer {
  display: flex;
  padding: 24rpx 32rpx;
  padding-bottom: calc(var(--safe-bottom) + 24rpx);
  border-top: 1rpx solid var(--border);
  background: #fff;
}

/* 表单 */
.form-item {
  margin-bottom: 28rpx;
}

.form-label {
  font-size: 28rpx;
  color: var(--text-secondary);
  margin-bottom: 14rpx;
  display: block;
  font-weight: 500;
}

.form-label .required {
  color: var(--red);
  margin-left: 4rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #e8eaed;
  border-radius: var(--radius-sm);
  padding: 0 24rpx;
  font-size: 30rpx;
  background: #fafbfc;
  transition: border-color 0.2s;
}

.form-input:focus {
  border-color: var(--primary);
  background: #fff;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  border: 1rpx solid #e8eaed;
  border-radius: var(--radius-sm);
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  background: #fafbfc;
  transition: border-color 0.2s;
}

.form-textarea:focus {
  border-color: var(--primary);
  background: #fff;
}

/* 按钮 */
.btn-primary {
  width: 100%;
  height: 96rpx;
  background: var(--primary-gradient);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
  transition: transform 0.2s, box-shadow 0.2s;
}

.btn-primary:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(74, 144, 217, 0.4);
}

.btn-primary[disabled] {
  opacity: 0.6;
}

.btn-secondary {
  width: 100%;
  height: 96rpx;
  background: var(--bg-page);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  color: var(--text-secondary);
}

.btn-secondary:active {
  background: #e8eaed;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 48rpx;
}

.empty-state .empty-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}

.empty-state .empty-title {
  font-size: 34rpx;
  font-weight: 500;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
}

.empty-state .empty-desc {
  font-size: 28rpx;
  color: var(--text-muted);
  text-align: center;
  line-height: 1.6;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx;
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  box-shadow: var(--shadow-sm);
}

.search-bar .search-input {
  flex: 1;
  font-size: 30rpx;
}

.search-bar .search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

/* FAB 按钮 */
.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(var(--safe-bottom) + 32rpx);
  width: 112rpx;
  height: 112rpx;
  background: var(--primary-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(74, 144, 217, 0.45);
  z-index: 100;
  transition: transform 0.2s, box-shadow 0.2s;
}

.fab-btn:active {
  transform: scale(0.94);
  box-shadow: 0 4rpx 14rpx rgba(74, 144, 217, 0.45);
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
}

/* ===== 工具类 ===== */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.text-center { text-align: center; }
.text-ellipsis { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.mt-8 { margin-top: 8rpx; }
.mt-16 { margin-top: 16rpx; }
.mt-20 { margin-top: 20rpx; }
.mb-20 { margin-bottom: 20rpx; }
.p-20 { padding: 20rpx; }
.gap-16 { gap: 16rpx; }
.safe-area-bottom { padding-bottom: env(safe-area-inset-bottom); }

/* ===== 动画 ===== */
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}

@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}
