.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #5eb97d 0%, #7ed6a5 100%);
  padding: 40rpx;
  padding-top: 80rpx;
  display: flex;
  flex-direction: column;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.form-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
  margin-bottom: 40rpx;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 10rpx;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.toggle-btn {
  font-size: 32rpx;
  padding: 10rpx;
}

.register-btn {
  margin-top: 40rpx;
  height: 96rpx;
  background: linear-gradient(135deg, #5eb97d 0%, #7ed6a5 100%);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(94, 185, 125, 0.4);
}

.register-btn text {
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
}

.register-btn[disabled] {
  opacity: 0.6;
}

.link-section {
  display: flex;
  justify-content: center;
  margin-top: 30rpx;
}

.link-text {
  font-size: 28rpx;
  color: #5eb97d;
}

.footer {
  margin-top: auto;
  text-align: center;
  padding-bottom: 40rpx;
}

.footer text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
