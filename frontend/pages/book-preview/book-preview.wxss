.container {
  min-height: 100vh;
  background: var(--bg-page);
}

.page-header {
  display: flex;
  align-items: center;
  padding: 60rpx 30rpx 30rpx;
  background: var(--purple-gradient);
  color: #fff;
}

.header-back {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
  margin-right: 20rpx;
  font-size: 36rpx;
  color: #fff;
}

.header-info {
  flex: 1;
}

.book-name {
  font-size: 36rpx;
  font-weight: 600;
  display: block;
}

.word-count {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 8rpx;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  margin: 20rpx;
  padding: 20rpx 30rpx;
  border-radius: 50rpx;
  box-shadow: var(--shadow-sm);
}

.search-input {
  flex: 1;
  font-size: 30rpx;
}

.search-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}

.word-list {
  padding: 0 20rpx 40rpx;
  height: calc(100vh - 280rpx);
}

.word-item {
  background: #fff;
  margin-bottom: 20rpx;
  padding: 30rpx;
  border-radius: var(--radius-md);
  box-shadow: var(--shadow-sm);
}

.word-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.word-main {
  display: flex;
  align-items: center;
}

.word-text {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-right: 20rpx;
}

.phonetic {
  font-size: 26rpx;
  color: var(--text-muted);
}

.word-part {
  font-size: 26rpx;
  color: var(--purple);
  background: rgba(99, 102, 241, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
}

.word-body {
  margin-bottom: 16rpx;
}

.word-definition {
  font-size: 30rpx;
  color: var(--text-primary);
  line-height: 1.5;
}

.word-example {
  background: #f8f8f8;
  padding: 20rpx;
  border-radius: var(--radius-sm);
  margin-top: 16rpx;
}

.example-sentence {
  font-size: 28rpx;
  color: var(--text-secondary);
  font-style: italic;
  display: block;
  margin-bottom: 8rpx;
}

.example-translation {
  font-size: 26rpx;
  color: var(--text-muted);
  display: block;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 30rpx;
}

.empty-text {
  font-size: 30rpx;
  color: var(--text-muted);
  margin-bottom: 16rpx;
}

.loading-state {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 100rpx 0;
  font-size: 28rpx;
  color: var(--text-muted);
}
