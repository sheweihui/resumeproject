.container {
  min-height: 100vh;
  background: linear-gradient(135deg, #4a90d9 0%, #67b8f7 100%);
  padding: 40rpx;
  padding-top: 80rpx;
  display: flex;
  flex-direction: column;
}

.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #fff;
  margin-bottom: 10rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.8);
}

.form-section {
  background: #fff;
  border-radius: 20rpx;
  padding: 0;
  margin-bottom: 40rpx;
  overflow: hidden;
}

.tab-bar {
  display: flex;
  border-bottom: 1rpx solid #f0f0f0;
}

.tab-item {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}

.tab-item text {
  font-size: 32rpx;
  color: #999;
  font-weight: 500;
}

.tab-item.active text {
  color: #4a90d9;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: #4a90d9;
  border-radius: 2rpx;
}

.form-content {
  padding: 40rpx;
}

.input-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  margin-bottom: 10rpx;
}

.input-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.input-field {
  flex: 1;
  font-size: 32rpx;
  color: #333;
}

.toggle-btn {
  font-size: 32rpx;
  padding: 10rpx;
}

.action-btn {
  margin-top: 40rpx;
  height: 96rpx;
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.action-btn text {
  font-size: 34rpx;
  font-weight: 600;
}

.login-btn {
  background: linear-gradient(135deg, #4a90d9 0%, #67b8f7 100%);
  box-shadow: 0 8rpx 24rpx rgba(74, 144, 217, 0.4);
}

.login-btn text {
  color: #fff;
}

.register-btn {
  background: linear-gradient(135deg, #5eb97d 0%, #7ed6a5 100%);
  box-shadow: 0 8rpx 24rpx rgba(94, 185, 125, 0.4);
}

.register-btn text {
  color: #fff;
}

.action-btn[disabled] {
  opacity: 0.6;
}

.other-options {
  display: flex;
  justify-content: center;
  padding: 30rpx;
  border-top: 1rpx solid #f0f0f0;
}

.other-options text {
  font-size: 26rpx;
  color: #999;
}

.footer {
  margin-top: auto;
  text-align: center;
  padding-bottom: 40rpx;
}

.footer text {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.7);
}
