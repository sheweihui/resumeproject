page {
  background-color: var(--bg-page);
}

.container {
  min-height: 100vh;
  background: var(--bg-page);
  padding-bottom: calc(var(--safe-bottom) + 120rpx);
}

.page-header {
  background: var(--green-gradient);
  padding: 60rpx 32rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.page-header .page-title {
  font-size: 44rpx;
  font-weight: 600;
  color: #fff;
}

.header-action {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.25);
  padding: 16rpx 28rpx;
  border-radius: 36rpx;
}

.header-action text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.book-list {
  padding: 24rpx;
}

.book-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: var(--radius-md);
  padding: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-sm);
  transition: transform 0.2s, box-shadow 0.2s;
}

.book-card:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
}

.book-cover {
  width: 110rpx;
  height: 110rpx;
  background: var(--green-gradient);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.cover-icon {
  font-size: 52rpx;
}

.book-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.book-name {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text-primary);
  margin-bottom: 10rpx;
}

.book-desc {
  font-size: 26rpx;
  color: var(--text-muted);
  margin-bottom: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.book-meta {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.word-count {
  font-size: 24rpx;
  color: var(--green);
}

.create-time {
  font-size: 24rpx;
  color: #bdc3c7;
}

.book-actions {
  display: flex;
  flex-direction: column;
  margin-right: 16rpx;
}

.book-actions .action-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  border-radius: var(--radius-sm);
  transition: all 0.2s;
}

.book-actions .action-btn:active {
  transform: scale(0.94);
}

.book-actions .edit-btn {
  color: #fff;
  background: var(--purple-gradient);
  margin-bottom: 10rpx;
}

.book-actions .delete-btn {
  color: #fff;
  background: linear-gradient(135deg, var(--red) 0%, #f65a78 100%);
}

.book-arrow {
  font-size: 44rpx;
  color: #dfe6e9;
  flex-shrink: 0;
}

.fab-btn {
  position: fixed;
  right: 32rpx;
  bottom: calc(var(--safe-bottom) + 32rpx);
  width: 112rpx;
  height: 112rpx;
  background: var(--green-gradient);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 28rpx rgba(94, 185, 125, 0.45);
  z-index: 100;
  transition: transform 0.2s, box-shadow 0.2s;
}

.fab-btn:active {
  transform: scale(0.94);
  box-shadow: 0 4rpx 14rpx rgba(94, 185, 125, 0.45);
}

.fab-icon {
  font-size: 56rpx;
  color: #fff;
  font-weight: 300;
}

/* Modal using design system */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 100%;
  max-height: 85vh;
  background: #fff;
  border-radius: 32rpx 32rpx 0 0;
  overflow: hidden;
  animation: slideUp 0.3s ease-out;
}

.modal-header {
  padding: 36rpx;
  border-bottom: 1rpx solid var(--border);
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--text-primary);
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
  color: var(--text-muted);
  border-radius: 50%;
  background: var(--bg-page);
}

.modal-body {
  padding: 32rpx;
  max-height: calc(85vh - 200rpx);
  overflow-y: auto;
}

.form-item {
  margin-bottom: 32rpx;
}

.form-label {
  font-size: 30rpx;
  color: var(--text-secondary);
  margin-bottom: 16rpx;
  display: block;
  font-weight: 500;
}

.form-label .required {
  color: var(--red);
  margin-left: 6rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  border: 1rpx solid #e8eaed;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #fafbfc;
  transition: border-color 0.2s, background 0.2s;
}

.form-input:focus {
  border-color: var(--green);
  background: #fff;
}

.form-input.flex-input {
  border-radius: 16rpx 0 0 16rpx;
}

.form-textarea {
  width: 100%;
  height: 140rpx;
  border: 1rpx solid #e8eaed;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  background: #fafbfc;
  transition: border-color 0.2s, background 0.2s;
}

.form-textarea:focus {
  border-color: var(--green);
  background: #fff;
}

.input-row {
  display: flex;
  align-items: center;
  width: 100%;
}

.ai-fill-btn {
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  height: 88rpx;
  background: var(--purple-gradient);
  border-radius: 0 16rpx 16rpx 0;
  flex-shrink: 0;
  transition: opacity 0.2s;
}

.ai-fill-btn:active {
  opacity: 0.85;
}

.ai-icon {
  font-size: 36rpx;
  margin-right: 10rpx;
}

.ai-text {
  font-size: 28rpx;
  color: #fff;
  font-weight: 500;
}

.book-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.book-option {
  padding: 16rpx 32rpx;
  background: var(--bg-page);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: var(--text-secondary);
  transition: all 0.2s;
}

.book-option:active {
  transform: scale(0.96);
}

.book-option.selected {
  background: var(--green-gradient);
  color: #fff;
}

.submit-btn {
  width: 100%;
  height: 96rpx;
  background: var(--green-gradient);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(94, 185, 125, 0.35);
  transition: transform 0.2s, box-shadow 0.2s;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 12rpx rgba(94, 185, 125, 0.35);
}

.btn-text {
  font-size: 34rpx;
  color: #fff;
  font-weight: 600;
}

.modal-footer {
  padding: 24rpx 32rpx calc(var(--safe-bottom) + 32rpx);
  border-top: 1rpx solid var(--border);
  background: #fff;
}

.cancel-btn {
  width: 100%;
  height: 96rpx;
  background: var(--bg-page);
  border-radius: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s;
}

.cancel-btn:active {
  background: #e8eaed;
}

.cancel-btn text {
  font-size: 34rpx;
  color: var(--text-secondary);
  font-weight: 500;
}
