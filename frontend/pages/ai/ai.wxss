.container {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.chat-area {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 200rpx;
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
}

.message-item.ai {
  flex-direction: row;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e8f4fd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-icon {
  font-size: 40rpx;
}

.message-content {
  max-width: 70%;
  padding: 20rpx 30rpx;
  border-radius: 24rpx;
  margin: 0 20rpx;
}

.message-item.ai .message-content {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 8rpx;
}

.message-item.user .message-content {
  background: #4a90d9;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  margin: 0 8rpx;
  animation: loading 1.4s infinite ease-in-out;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes loading {
  0%, 80%, 100% {
    transform: scale(0);
    opacity: 0.5;
  }
  40% {
    transform: scale(1);
    opacity: 1;
  }
}

.quick-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 160rpx;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
}

.action-item {
  display: inline-block;
  background: #f5f7fa;
  padding: 16rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 16rpx;
}

.input-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
}

.input-box {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  background: #4a90d9;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
}

.send-btn text {
  color: #fff;
  font-size: 28rpx;
}
