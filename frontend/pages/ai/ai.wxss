.container {
  min-height: 100vh;
  background: #f5f5f5;
  display: flex;
  flex-direction: column;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 60rpx 30rpx 20rpx;
  background: linear-gradient(135deg, #4a90d9 0%, #67b8f7 100%);
}

.header-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #fff;
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.header-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 64rpx;
  height: 64rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 50%;
}

.header-btn-icon {
  font-size: 32rpx;
}

.chat-area {
  flex: 1;
  padding: 20rpx;
  padding-bottom: 220rpx;
  height: calc(100vh - 300rpx);
}

.message-item {
  display: flex;
  margin-bottom: 30rpx;
}

.message-item.ai {
  flex-direction: row;
}

.message-item.user {
  flex-direction: row-reverse;
}

.avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #e8f4fd;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-icon {
  font-size: 40rpx;
}

.message-content {
  max-width: 70%;
  padding: 20rpx 30rpx;
  border-radius: 24rpx;
  margin: 0 20rpx;
  overflow: hidden;
}

.msg-text {
  font-size: 28rpx;
  line-height: 1.8;
  white-space: pre-wrap;
  word-break: break-word;
}

.message-item.ai .message-content {
  background: #fff;
  color: #333;
  border-bottom-left-radius: 8rpx;
}

.message-item.ai .msg-text {
  color: #333;
}

.message-item.user .message-content {
  background: #4a90d9;
  color: #fff;
  border-bottom-right-radius: 8rpx;
}

.message-item.user .msg-text {
  color: #fff;
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}

.loading-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #ccc;
  margin: 0 8rpx;
  animation: loading 1.4s infinite ease-in-out;
}

.loading-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.loading-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes loading {
  0%, 80%, 100% { transform: scale(0); opacity: 0.5; }
  40% { transform: scale(1); opacity: 1; }
}

.quick-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 160rpx;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  z-index: 10;
}

.action-item {
  display: inline-block;
  background: #f5f7fa;
  padding: 16rpx 28rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  color: #666;
  margin-right: 20rpx;
  margin-bottom: 16rpx;
}

.input-area {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 20rpx;
  background: #fff;
  border-top: 1rpx solid #eee;
  padding-bottom: calc(20rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.input-box {
  flex: 1;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 40rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.send-btn {
  width: 120rpx;
  height: 80rpx;
  background: #4a90d9;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  flex-shrink: 0;
}

.send-btn text {
  color: #fff;
  font-size: 28rpx;
}

.send-btn.disabled {
  background: #ccc;
}

.retry-btn {
  display: inline-flex;
  align-items: center;
  padding: 6rpx 16rpx;
  margin-top: 8rpx;
  background: #fff3f3;
  border-radius: 12rpx;
  font-size: 22rpx;
  color: #e74c3c;
}

.retry-btn:active {
  opacity: 0.7;
}
